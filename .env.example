# ─────────────────────────────────────────────────────────────────────────────
# LocalLead · variables de entorno (copia a .env.local; NUNCA subas claves reales)
# ─────────────────────────────────────────────────────────────────────────────

# Base de datos PostgreSQL (obligatoria). Con Supabase: Project Settings → Database →
# Connection string (modo "Transaction pooler", puerto 6543) con la contraseña de tu proyecto.
DATABASE_URL=postgres://postgres:CONTRASEÑA@HOST:6543/postgres

# Opcional: conexión directa solo para `npm run db:migrate` (si no se define, usa DATABASE_URL)
# MIGRATE_DATABASE_URL=postgres://postgres:CONTRASEÑA@db.PROYECTO.supabase.co:5432/postgres

# URL pública de la app (enlaces de confirmación de correo y User-Agent de las peticiones salientes)
APP_URL=http://localhost:3000
# Correo de contacto que se incluye en el User-Agent (recomendado por OSM/Nominatim/Overpass)
# CONTACT_EMAIL=tu@correo.com

# ── Autenticación ────────────────────────────────────────────────────────────
# "supabase" (por defecto): Supabase Auth. "dev": usuario único local SIN login; solo para desarrollo,
# la app se niega a arrancar con AUTH_MODE=dev en producción.
AUTH_MODE=supabase
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Inteligencia artificial (solo servidor) ──────────────────────────────────
OPENAI_API_KEY=
# Modelo con soporte de salida estructurada (consulta platform.openai.com/docs/models)
OPENAI_MODEL=

# ── Fuentes de datos ─────────────────────────────────────────────────────────
# OpenStreetMap/Overpass no necesita clave. Lista de endpoints separados por comas (respaldo en orden).
# OVERPASS_URL=https://overpass-api.de/api/interpreter,https://overpass.openstreetmap.fr/api/interpreter
# NOMINATIM_URL=https://nominatim.openstreetmap.org

# Google Places API (New): activa la fuente "Google Places" (tiene coste; ver README)
GOOGLE_PLACES_API_KEY=

# PageSpeed Insights API (Lighthouse en móvil) para rendimiento/accesibilidad/SEO medidos
PAGESPEED_API_KEY=
